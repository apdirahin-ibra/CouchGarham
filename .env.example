# Database Connection (Supabase Transaction Pooler recommended)
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"

# Better Auth & Session Secret (Generate with `openssl rand -hex 32`)
BETTER_AUTH_SECRET="3006d65e217a926303da319de0c6fd77301cdeb267d5fc25306bf79f28997b25"
BETTER_AUTH_URL="http://localhost:3000"

# Supabase Storage & API Keys
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-side Public Aliases (Required for Vite browser environment)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_APP_URL="http://localhost:3000"

# Initial Admin Setup Seed (Used during `npm run db:seed`)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="your-strong-admin-password"

# Node Environment
NODE_ENV="development"
